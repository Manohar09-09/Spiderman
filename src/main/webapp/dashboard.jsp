<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Student dashboard | Spidy</title><link rel="stylesheet" href="css/style.css"></head><body><nav><a class="brand" href="index.jsp">SPIDY</a><a href="dashboard">Dashboard</a><a href="missions">Missions</a><a href="leaderboard">Leaderboard</a><a href="logout">Logout</a></nav><main class="panel"><h1>Student dashboard</h1><% String msg=(String)session.getAttribute("msg"); if(msg!=null){out.println("<div class='notice'>"+msg+"</div>");session.removeAttribute("msg");} %><% if(session.getAttribute("userId")==null){response.sendRedirect("login.jsp");return;} java.sql.ResultSet rs=(java.sql.ResultSet)request.getAttribute("stats"); if(rs!=null&&rs.next()){int xp=rs.getInt("total_xp"); %><p>Welcome, <strong><%=rs.getString("username")%></strong></p><div class="stats"><div>XP<h2><%=xp%></h2></div><div>Level<h2><%=rs.getInt("player_level")%></h2></div><div>Completed<h2><%=rs.getInt("completed")%></h2></div><div>XP to next level<h2><%=100-xp%100%></h2></div></div><% } %><a class="btn" href="missions">Play missions</a><a class="btn secondary" href="leaderboard">Leaderboard</a></main></body></html>
