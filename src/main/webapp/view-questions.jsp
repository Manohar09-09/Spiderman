<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Manage questions | Spidy</title><link rel="stylesheet" href="css/style.css"></head><body><nav><a class="brand" href="index.jsp">SPIDY</a><a href="dashboard">Dashboard</a><a href="missions">Missions</a><a href="leaderboard">Leaderboard</a><a href="logout">Logout</a></nav><main class="panel"><h1>Manage questions</h1><% String msg=(String)session.getAttribute("msg"); if(msg!=null){out.println("<div class='notice'>"+msg+"</div>");session.removeAttribute("msg");} %><% if(session.getAttribute("adminId")==null){response.sendRedirect("admin-login.jsp");return;} java.sql.ResultSet rs=(java.sql.ResultSet)request.getAttribute("questions"); %><table><tr><th>Title</th><th>Category</th><th>Difficulty</th><th>XP</th></tr><% while(rs!=null&&rs.next()){ %><tr><td><%=rs.getString("title")%></td><td><%=rs.getString("category")%></td><td><%=rs.getString("difficulty")%></td><td><%=rs.getInt("xp_reward")%></td></tr><% } %></table></main></body></html>
