<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Global leaderboard | Spidy</title><link rel="stylesheet" href="css/style.css"></head><body><nav><a class="brand" href="index.jsp">SPIDY</a><a href="dashboard">Dashboard</a><a href="missions">Missions</a><a href="leaderboard">Leaderboard</a><a href="logout">Logout</a></nav><main class="panel"><h1>Global leaderboard</h1><% String msg=(String)session.getAttribute("msg"); if(msg!=null){out.println("<div class='notice'>"+msg+"</div>");session.removeAttribute("msg");} %><% java.sql.ResultSet rs=(java.sql.ResultSet)request.getAttribute("players");int rank=0; %><table><tr><th>Rank</th><th>Player</th><th>Level</th><th>Completed</th><th>XP</th></tr><% while(rs!=null&&rs.next()){rank++;String medal=rank==1?"🏆":rank==2?"🥈":rank==3?"🥉":""; %><tr><td><%=medal%> #<%=rank%></td><td><%=rs.getString("username")%></td><td><%=rs.getInt("player_level")%></td><td><%=rs.getInt("completed")%></td><td><%=rs.getInt("total_xp")%></td></tr><% }if(rank==0)out.println("<tr><td colspan=5>No players yet</td></tr>"); %></table></main></body></html>
