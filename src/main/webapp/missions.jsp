<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Programming missions | Spidy</title><link rel="stylesheet" href="css/style.css"></head><body><nav><a class="brand" href="index.jsp">SPIDY</a><a href="dashboard">Dashboard</a><a href="missions">Missions</a><a href="leaderboard">Leaderboard</a><a href="logout">Logout</a></nav><main class="panel"><h1>Programming missions</h1><% String msg=(String)session.getAttribute("msg"); if(msg!=null){out.println("<div class='notice'>"+msg+"</div>");session.removeAttribute("msg");} %><% if(session.getAttribute("userId")==null){response.sendRedirect("login.jsp");return;} java.sql.ResultSet rs=(java.sql.ResultSet)request.getAttribute("missions");boolean any=false;while(rs!=null&&rs.next()){any=true; %><section class="mission"><span class="tag"><%=rs.getString("category")%> · <%=rs.getString("difficulty")%> · <%=rs.getInt("xp_reward")%> XP</span><h2><%=rs.getString("title")%></h2><p><%=rs.getString("description")%></p><form method="post" action="submit-answer"><input type="hidden" name="missionId" value="<%=rs.getInt("id")%>"><% String[] os={"option_a","option_b","option_c","option_d"};for(String o:os){String v=rs.getString(o); %><label class="choice"><input type="radio" name="answer" value="<%=v%>" required> <%=v%></label><% } %><button class="btn">Submit answer</button></form></section><% }if(!any)out.println("<p>No missions available right now.</p>"); %></main></body></html>
