<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Create account | Spidy</title><link rel="stylesheet" href="css/style.css"></head><body><nav><a class="brand" href="index.jsp">SPIDY</a><a href="dashboard">Dashboard</a><a href="missions">Missions</a><a href="leaderboard">Leaderboard</a><a href="logout">Logout</a></nav><main class="panel"><h1>Create account</h1><% String msg=(String)session.getAttribute("msg"); if(msg!=null){out.println("<div class='notice'>"+msg+"</div>");session.removeAttribute("msg");} %><form method="post" action="register"><label>Username</label><input name="username" required maxlength="50"><label>Email</label><input type="email" name="email" required><label>Password (min 6)</label><input type="password" name="password" required><label>Confirm password</label><input type="password" name="confirmPassword" required><button class="btn">Register</button></form><p>Already registered? <a href="login.jsp">Login</a></p></main></body></html>
