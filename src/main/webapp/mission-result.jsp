<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Mission result | Spidy</title><link rel="stylesheet" href="css/style.css"></head><body><nav><a class="brand" href="index.jsp">SPIDY</a><a href="dashboard">Dashboard</a><a href="missions">Missions</a><a href="leaderboard">Leaderboard</a><a href="logout">Logout</a></nav><main class="panel"><h1>Mission result</h1><% String msg=(String)session.getAttribute("msg"); if(msg!=null){out.println("<div class='notice'>"+msg+"</div>");session.removeAttribute("msg");} %><% if(session.getAttribute("userId")==null){response.sendRedirect("login.jsp");return;}String v=(String)session.getAttribute("result"); %><p class="result"><%=v==null?"No recent result":v%></p><%session.removeAttribute("result");%><a class="btn" href="missions">More missions</a><a class="btn secondary" href="dashboard">Dashboard</a></main></body></html>
